es":["Take-off time: 05:40"]},{"tag":"Para","values":["Flight time: 18 mins"]},{"tag":"Para","values":["Weather: Thick fog"]},{"tag":"Para","values":["An armored supply convoy has been sighted traveling at night on the Nicosia to Famagusta road near to where the Perieos and Yialias rivers meet. The enemy is taking advantage of the foggy weather to move supplies to the east of the island. You must find and intercept the convoy using your radar."]},{"tag":"Outstanding","values":["Despite the difficult flying conditions, all of the supply trucks were destroyed. Your success has left the enemy short of vital supplies. "]},{"tag":"Success","values":["Despite the difficult flying conditions, most of the supply trucks were destroyed. Those that escaped were insufficient to alleviate the enemy supply shortages."]},{"tag":"Failure","values":["Your  failure to destroy the convoy was disappointing, considering the Apache's all- weather capability. The enemy have been able to alleviate supply shortages."]},{"tag":"EOF","values":[]}],"metadata":{"Game Flow":3,"War Zone":3,"Campaign Level":8},"data_tags":[{"tag":"Task","values":[]},{"tag":"User Task","values":[]},{"tag":"Side","values":["1"]},{"tag":"Task Type","values":["4"]},{"tag":"Drone","values":[]},{"tag":"Drone Type","values":["103"]},{"tag":"Drone Start Time","values":["1000"]},{"tag":"Waypoint","values":["1,150517582,173917057,0,0,0,0,0,0","2,151875693,180542989,25600,22200,60480,22200,6763733,0","4,156506751,187356970,25600,49400,60480,27200,8238752,0","4,158881387,187369735,25600,67600,25920,18200,2374670,0","4,165008071,185252724,25600,117600,25920,50000,6482128,0","2,168212155,182531519,25600,131400,60480,13800,4203702,0","2,165928423,180058570,25600,142400,60480,11000,3366141,0","2,160786151,177400316,25600,161400,60480,19000,5788719,0","2,157808335,177307741,25600,171200,60480,9800,2979254,0","2,152963535,172324094,25600,194000,60480,22800,6950454,0","2,150516892,173917365,0,203600,60480,9600,2919799,0"]},{"tag":"D